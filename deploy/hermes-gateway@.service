[Unit]
# Шлюз Hermes для одного пользователя: исполняет задачи по расписанию (кроны).
# Без него задачи создаются, но не срабатывают: дашборд их не исполняет.
# Имя экземпляра %i — имя пользователя без префикса: hermes-gateway@ivanov.
Description=Hermes gateway for %i (scheduled jobs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes-%i
Group=hermes-%i
Slice=hermes.slice                      # общий срез: лимиты на всех пользователей сразу
WorkingDirectory=/opt/hermes            # обязательно: пакет не установлен в окружение

# Шлюз работает в переднем плане — systemd сам следит за процессом.
ExecStart=/opt/hermes/venv/bin/python -m hermes_cli.main gateway

Restart=on-failure
RestartSec=10s

# ── Песочница: та же, что у дашборда ────────────────────────────────────────
NoNewPrivileges=yes                     # процесс не может повысить свои права
ProtectSystem=strict                    # вся система только на чтение
ProtectHome=tmpfs                       # чужие домашние каталоги не видны
BindPaths=/home/hermes-%i               # свой — виден
ReadWritePaths=/home/hermes-%i /srv/hermes/%i    # писать можно только к себе
PrivateTmp=yes                          # свой /tmp, не общий
ProtectProc=invisible                   # чужие процессы не видны
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes

# ── Ресурсы: шлюз легче дашборда, но лимит нужен ────────────────────────────
MemoryMax=1G
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
